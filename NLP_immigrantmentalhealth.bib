@article{bakhshalizadehImpactF2Visa2025,
  title = {Impact of {{F-2 Visa Work Restrictions}} on {{Financial}} and {{Marital Life}} of {{F-2 Visa Holders}}},
  author = {Bakhshalizadeh, Fatemeh},
  year = 2025,
  month = jul,
  journal = {Family Transitions},
  volume = {66},
  number = {5},
  pages = {283--299},
  publisher = {Routledge},
  issn = {2837-5300},
  doi = {10.1080/28375300.2025.2457172},
  urldate = {2026-09-05},
  abstract = {Studies on female immigrants show that unequal status of couples within the household links to marital dissatisfaction and domestic abuse especially when their immigration status and financial aspects of their life depend on their husband. As the spouses of international students' immigration status and financial life depend on their student spouse since F-2 visa regulations prevent them from earning money, there is a gap in the literature about how F-2 visa regulations affect the financial and marital life of female F-2 visa holders, who used to work before coming to the US. This article through the Intersectionality lens (Crenshaw, 1991), interviewing 16 women from 10 different countries, and phenomenological analysis showed that although the women lost their pre-migration financial power, they did not report abuse, and the topics of marital conflicts circled around experiencing negative feelings, couple's different lifestyles, and facing financial issues caused by not working/earning money.},
  keywords = {dependency,financial well-being,immigrants,Intersectionality,marriage,women}
}

