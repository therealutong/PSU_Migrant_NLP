@article{banerjeeSubversiveSelfEmploymentIntersectionality2019,
  title = {Subversive {{Self-Employment}}: {{Intersectionality}} and {{Self-Employment Among Dependent Visas Holders}} in the {{United States}}},
  shorttitle = {Subversive {{Self-Employment}}},
